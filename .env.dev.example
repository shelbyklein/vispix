# Reference for the DEV stack's env file: ~/vispix-dev/app/.env on the Beelink.
#
# The dev stack (deploy/dev/docker-compose.yml, run via scripts/vispix-dev.sh)
# is exposed at dev.vispix.dev and mcp-dev.vispix.dev — see docs/DEV_ENVIRONMENT.md.
# Lines marked "DEV OVERRIDE" differ from prod. Secrets marked "MUST match prod"
# stay identical so sessions / encrypted AI keys cloned from prod still validate.
#
# The dev WEB port (8085) is NOT set here — it's set by the `dev:web:dev` script.
# This PORT value is what the dev API server binds to.

# --- Required to boot the API server ---
PORT=8084                                                    # DEV OVERRIDE (prod: 8080)
# DEV OVERRIDE: dev has its OWN database (vispix_dev in the dev Postgres
# container). Schema changes / migrations are safe here.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/vispix_dev
BETTER_AUTH_SECRET=<copy the exact value from your prod .env>            # MUST match prod
BETTER_AUTH_URL=https://dev.vispix.dev/api/auth              # DEV OVERRIDE
APP_PUBLIC_URL=https://dev.vispix.dev                        # DEV OVERRIDE

# --- Object storage (dev's own fake-gcs copy at ~/vispix-dev/storage) ---
GCS_ENDPOINT=http://localhost:4443
GCS_BROWSER_UPLOAD_PREFIX=/gcs
PUBLIC_OBJECT_SEARCH_PATHS=/targetvision/public
PRIVATE_OBJECT_DIR=/targetvision/private

# --- AI providers ---
AI_KEY_ENCRYPTION_SECRET=<copy the exact value from your prod .env>      # MUST match prod (decrypts cloned AI keys)

# --- Misc ---
LOG_LEVEL=info
# DEV OVERRIDE: add the dev web origin + dev public hostname so Better Auth
# accepts credentialed requests coming through the dev subdomain.
CORS_ORIGINS=http://localhost:8085,https://dev.vispix.dev
TRUSTED_ORIGINS=http://localhost:8085,https://dev.vispix.dev

# Left over from when dev shared prod's storage bucket; dev storage is now its
# own copy, so this is optional. Keeps dev deletes from removing image files.
PHOTO_STORAGE_DELETE_DISABLED=true

# DEV OVERRIDE: shows the "DEV" badge in the web UI header (issue #130).
# Never set this in the prod .env — prod shows no indicator.
VITE_ENVIRONMENT=dev

# --- MCP gateway (mcp-dev.vispix.dev) ---
# DEV OVERRIDE: dev gets its OWN token (openssl rand -hex 32) — never prod's.
MCP_AUTH_TOKEN=<openssl rand -hex 32>
MCP_PUBLIC_URL=https://mcp-dev.vispix.dev
# Optional media-link signing key; unset = derived from BETTER_AUTH_SECRET. Dev
# links can't open prod media either way (they're bound to MCP_PUBLIC_URL).
# MCP_MEDIA_SIGNING_KEY=<openssl rand -hex 32>

# --- Image embeddings (Vertex AI — same as prod) ---
GOOGLE_APPLICATION_CREDENTIALS=/home/sklein/vispix-dev/secrets/vertex-embeddings.json
VERTEX_PROJECT=targetvision-502503
VERTEX_LOCATION=us-central1
