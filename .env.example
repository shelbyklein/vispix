# Copy to .env and fill in real values. Everything runs locally — no cloud accounts needed.

# --- Required to boot the API server ---
PORT=8080
DATABASE_URL=postgres://localhost:5433/vispix
BETTER_AUTH_SECRET=                # generate: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:8080/api/auth

# --- Object storage (fake-gcs-server via `docker compose up -d`) ---
GCS_ENDPOINT=http://localhost:4443
GCS_BROWSER_UPLOAD_PREFIX=/gcs     # dev-only: browser uploads ride the Vite /gcs proxy (no CORS)
# SIGN_UPLOAD_LENGTH_RANGE=true    # bind the declared size into upload URLs (real GCS: add the header to bucket CORS first — deploy/DEPLOY.md)
PUBLIC_OBJECT_SEARCH_PATHS=/targetvision/public
PRIVATE_OBJECT_DIR=/targetvision/private

# --- AI providers ---
# AI_KEY_ENCRYPTION_SECRET is required to boot (encrypts admin-entered keys).
# The AI_INTEGRATIONS_* vars below are optional: they're only a fallback used
# when no key is configured in the admin UI (Settings > AI Services), and
# aren't required to start the server. Leave them unset until needed.
AI_KEY_ENCRYPTION_SECRET=          # generate: openssl rand -hex 32
# SESSION_SECRET is an optional fallback: if AI_KEY_ENCRYPTION_SECRET is unset,
# secretCrypto.ts derives the AI-key encryption key from SESSION_SECRET instead.
# Set one or the other. generate: openssl rand -hex 32
# SESSION_SECRET=
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# AI_INTEGRATIONS_GEMINI_API_KEY=...

# --- Image generation limits (per process, in memory; defaults shown) ---
# Pending+running generation jobs allowed per organization / per user / overall.
# Over a cap the API answers 429 (code generation_busy / generation_queue_full).
# GENERATION_MAX_PENDING_PER_ORG=6
# GENERATION_MAX_PENDING_PER_USER=4
# GENERATION_MAX_QUEUE=40
# Plan/generate requests allowed per org / per user within the window
# (429 code generation_rate_limited, with Retry-After).
# GENERATION_RATE_LIMIT_PER_ORG=40
# GENERATION_RATE_LIMIT_PER_USER=20
# GENERATION_RATE_WINDOW_SEC=600

# --- Photo Graph request limits ---
# GET /photos/:id/graph requests per user / per org within the window
# (429 code graph_rate_limited, with Retry-After).
# GRAPH_RATE_LIMIT_PER_USER=120
# GRAPH_RATE_LIMIT_PER_ORG=600
# GRAPH_RATE_WINDOW_SEC=60

# --- Image embeddings (Google Vertex AI — semantic photo search & similar photos) ---
# Optional: only needed if you enable image embeddings in Admin > AI Services.
# Auth is Google ADC via a service-account JSON with the "Vertex AI User" role,
# plus your GCP project id and a region where multimodalembedding@001 is
# available (us-central1 is safe). Use forward slashes in the credentials path.
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/.gcp/vertex-embeddings.json
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=us-central1

# --- Misc ---
# Extra origins allowed to make credentialed API requests / auth requests,
# beyond the localhost:8080/8081 dev defaults. Comma-separated.
CORS_ORIGINS=
TRUSTED_ORIGINS=
LOG_LEVEL=info
# Pin the "default org" (owns legacy unprefixed object keys and scopes the
# MCP_AUTH_TOKEN break-glass token) by id or slug. Unset = lowest-id org, with a
# startup warning. A pin that matches no org fails closed.
DEFAULT_ORG_ID=
DEFAULT_ORG_SLUG=

# MCP HTTP gateway (remote photo search). Token gates the publicly tunneled
# endpoint — generate with: openssl rand -hex 32. Public URL is the tunnel
# hostname; get_photo download links are built from it.
MCP_AUTH_TOKEN=
MCP_PUBLIC_URL=
# Optional: key for the gateway's expiring media links (>= 32 chars; defaults to
# a key derived from BETTER_AUTH_SECRET). PREVIOUS keeps old links valid during
# a rotation. See artifacts/mcp-server/README.md#media-links.
MCP_MEDIA_SIGNING_KEY=
MCP_MEDIA_SIGNING_KEY_PREVIOUS=

# --- Transactional email (SMTP, e.g. Elastic Email) ---
# Optional in dev: if SMTP_HOST/USER/PASS are unset, the app still boots and
# emails are logged instead of sent. Set all three to actually send.
#   SMTP_HOST=smtp.elasticemail.com
#   SMTP_PORT=2525            # 587/2525 = STARTTLS; 465 = implicit TLS
#   SMTP_USER=you@example.com # Elastic Email account email
#   SMTP_PASS=                # Elastic Email SMTP / API key
# SMTP_SECURE=true            # only if using implicit TLS on a nonstandard port
# EMAIL_FROM="Vispix <noreply@vispix.dev>"   # verified sender domain
# EMAIL_REPLY_TO=             # optional default reply-to
# APP_PUBLIC_URL=http://localhost:8081       # web origin for links in emails
# ADMIN_ALERT_EMAIL=          # operator inbox for new-signup / new-org alerts
